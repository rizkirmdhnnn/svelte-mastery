{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "svelte-sveltekit-mastery",
  "compatibility_date": "2026-06-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "observability": {
    "enabled": true,
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "tanya-svelte",
      "remote": true,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CHAT_KV",
      "id": "c19e2af5802741eb87dcaa91171151bf",
      "remote": true,
    },
  ],
  "vars": {
    // Answer model = Gemini. Requires the GEMINI_API_KEY secret:
    //   npx wrangler secret put GEMINI_API_KEY
    "CHAT_PROVIDER": "gemini",
    "CHAT_MODEL": "gemini-2.5-flash-lite",
    // EMBED_MODEL stays on Workers AI — retrieval (embeddings + Vectorize) is provider-independent.
    "EMBED_MODEL": "@cf/baai/bge-m3",
    "CHAT_RATE_LIMIT": "40",
    // Min top-match similarity to answer. Below this → "di luar materi" refusal.
    // Calibrated (scripts/calibrate-relevance.mjs): off-topic ≤0.46, on-topic ≥0.62.
    "CHAT_RELEVANCE_FLOOR": "0.5",
  },
}
