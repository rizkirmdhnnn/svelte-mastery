		{ legacy: "Semua nilai bertipe string, tanpa validasi", modern: "schema StandardSchema: validasi + transform + tipe ter-infer", note: 'valibot/zod/arktype' },
		{ legacy: "import { X } from '$env/static/private'", modern: "import { X } from '$app/env/private'", note: 'deklarasikan dulu X di src/env.ts' }
	]}
/>

