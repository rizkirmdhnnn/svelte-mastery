{
  "name": "svelte-sveltekit-mastery",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "manifest": "node scripts/gen-manifest.mjs",
    "data": "node scripts/gen-data.mjs",
    "coverage": "node scripts/check-coverage.mjs",
    "predev": "node scripts/gen-data.mjs && node scripts/gen-manifest.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/gen-data.mjs && node scripts/gen-manifest.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf:preview": "npm run build && wrangler dev",
    "prepare": "svelte-kit sync && wrangler types",
    "check": "svelte-kit sync && wrangler types && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.36.1",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^22.19.19",
    "codemirror": "^6.0.2",
    "mdsvex": "^0.12.7",
    "rehype-slug": "^6.0.0",
    "shiki": "^4.2.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "wrangler": "^4.98.0"
  }
}
